rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Core Infrastructure Helpers
    // -------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        isSuperAdminEmail() ||
        ('firebase' in request.auth.token && 
         'sign_in_provider' in request.auth.token.firebase && 
         request.auth.token.firebase.sign_in_provider == "google.com")
      );
    }

    function isSuperAdminEmail() {
      return (
        ('email' in request.auth.token && 
         request.auth.token.email in ["castimamoise@gmail.com", "castimaklik@gmail.com", "laperletourht@gmail.com", "aperletourht@gmail.com"]) ||
        ('phone_number' in request.auth.token && 
         request.auth.token.phone_number in ["+50944408687", "+50944408688", "+5094440-8687"])
      );
    }

    function isTargetSuperAdminEmail(targetEmail) {
      return targetEmail in ["castimamoise@gmail.com", "castimaklik@gmail.com", "laperletourht@gmail.com", "aperletourht@gmail.com"];
    }

    // -------------------------------------------------------------
    // Role & Activity Helpers (Single cached lookup on current user)
    // -------------------------------------------------------------
    function userDocExists() {
      return exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function getUserRolesFor(data) {
      return ('roles' in data && data.roles is list && data.roles.size() > 0)
        ? data.roles
        : (('role' in data && data.role is string)
            ? [data.role.lower()]
            : ["lecture_seule"]);
    }

    function getUserRoles() {
      return isSuperAdminEmail() 
        ? ["admin"] 
        : (userDocExists() 
            ? getUserRolesFor(getUserData())
            : ["lecture_seule"]);
    }

    function hasRole(r) {
      return isVerified() && isUserActive() && (
        isSuperAdminEmail() || 
        r in getUserRoles()
      );
    }

    function hasAnyRole(rolesList) {
      return isVerified() && isUserActive() && (
        isSuperAdminEmail() || 
        getUserRoles().hasAny(rolesList)
      );
    }

    function hasAllRoles(rolesList) {
      return isVerified() && isUserActive() && (
        isSuperAdminEmail() || 
        getUserRoles().hasAll(rolesList)
      );
    }

    function isUserActive() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        (userDocExists() && (
          ('status' in getUserData() && getUserData().status in ["actif", "Actif", "ACTIF"]) ||
          ('statutCompte' in getUserData() && getUserData().statutCompte in ["actif", "Actif", "ACTIF"])
        ))
      );
    }

    function isAdmin() {
      return isVerified() && isUserActive() && (
        isSuperAdminEmail() || 
        hasRole("admin") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDirection() {
      return hasRole("direction");
    }

    function isComptabilite() {
      return hasRole("comptabilite");
    }

    function isSecretaire() {
      return hasRole("secretaire");
    }

    function isOperations() {
      return hasRole("operations");
    }

    function isChauffeur() {
      return hasRole("chauffeur");
    }

    function isClient() {
      return hasRole("client");
    }

    function isLectureSeule() {
      return hasRole("lecture_seule");
    }

    // High-level access bundles
    function canManageOperations() {
      return isAdmin() || isDirection() || isOperations() || isSecretaire();
    }

    function canReadOperations() {
      return isAdmin() || isDirection() || isOperations() || isSecretaire() || isComptabilite();
    }

    function canManageFinances() {
      return isAdmin() || isDirection() || isComptabilite();
    }

    function canReadFinances() {
      return isAdmin() || isDirection() || isComptabilite() || isSecretaire();
    }

    function canReadGlobalFinances() {
      return isAdmin() || isDirection() || isComptabilite();
    }

    function canManageNotifications() {
      return isAdmin() || isDirection() || isOperations() || isSecretaire() || isComptabilite();
    }

    // -------------------------------------------------------------
    // Data Isolation for CHAUFFEUR and CLIENT (Stable Identifiers)
    // -------------------------------------------------------------
    function isChauffeurDoc(data) {
      return isChauffeur() && (
        (('chauffeurId' in data) && data.chauffeurId == request.auth.uid) ||
        (('driverId' in data) && data.driverId == request.auth.uid) ||
        (('uid' in data) && data.uid == request.auth.uid) ||
        (('email' in data) && data.email == request.auth.token.email)
      );
    }

    function isClientDoc(data) {
      return isClient() && (
        (('clientId' in data) && data.clientId == request.auth.uid) ||
        (('uid' in data) && data.uid == request.auth.uid) ||
        (('email' in data) && data.email == request.auth.token.email)
      );
    }

    function isNotificationTarget(data) {
      return (
        (('targetUid' in data) && (data.targetUid == request.auth.uid || data.targetUid == "all" || data.targetUid == "broadcast")) ||
        (('broadcast' in data) && data.broadcast == true) ||
        (('userId' in data) && data.userId == request.auth.uid) ||
        (('uid' in data) && data.uid == request.auth.uid) ||
        (('clientId' in data) && data.clientId == request.auth.uid) ||
        (('chauffeurId' in data) && data.chauffeurId == request.auth.uid) ||
        (('email' in data) && data.email == request.auth.token.email)
      );
    }

    // -------------------------------------------------------------
    // Validation Helpers
    // -------------------------------------------------------------
    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('zone' in data) || (data.zone is string && data.zone.size() <= 100)) &&
        (!('service' in data) || (data['service'] is string && data['service'].size() <= 100)) &&
        (!('route' in data) || (data.route is string && data.route.size() <= 200)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidEleve(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        (!('school' in data) || (data.school is string && data.school.size() <= 150)) &&
        (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 50)) &&
        (!('route' in data) || (data.route is string && data.route.size() <= 200)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidAbonnement(data) {
      return (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
        (!('price' in data) || (data.price is number && data.price >= 0)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidChauffeur(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('vehicle' in data) || (data.vehicle is string && data.vehicle.size() <= 150)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('commission' in data) || (data.commission is number && data.commission >= 0)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidVehicule(data) {
      return (!('brand' in data) || (data.brand is string && data.brand.size() <= 150)) &&
        (!('model' in data) || (data.model is string && data.model.size() <= 150)) &&
        (!('plate' in data) || (data.plate is string && data.plate.size() <= 50)) &&
        (!('driver' in data) || (data.driver is string && data.driver.size() <= 150)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('capacity' in data) || (data.capacity is number && data.capacity >= 0)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidPlanning(data) {
      return (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('route' in data) || (data.route is string && data.route.size() <= 200)) &&
        (!('driver' in data) || (data.driver is string && data.driver.size() <= 150)) &&
        (!('vehicle' in data) || (data.vehicle is string && data.vehicle.size() <= 150)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidPaiement(data) {
      return data.amount is number && data.amount >= 0 &&
        (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('method' in data) || (data.method is string && data.method.size() <= 50)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('reference' in data) || (data.reference is string && data.reference.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidReservation(data) {
      return (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('origin' in data) || (data.origin is string && data.origin.size() <= 200)) &&
        (!('destination' in data) || (data.destination is string && data.destination.size() <= 200)) &&
        (!('route' in data) || (data.route is string && data.route.size() <= 200)) &&
        (!('driver' in data) || (data.driver is string && data.driver.size() <= 150)) &&
        (!('vehicle' in data) || (data.vehicle is string && data.vehicle.size() <= 150)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 50)) &&
        (!('passengers' in data) || (data.passengers is number && data.passengers >= 0)) &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0)) &&
        (!('price' in data) || (data.price is number && data.price >= 0)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidFinance(data) {
      return (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        data.amount is number && data.amount >= 0 &&
        (!('label' in data) || (data.label is string && data.label.size() <= 200)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('driver' in data) || (data.driver is string && data.driver.size() <= 150)) &&
        (!('driverId' in data) || (data.driverId is string && data.driverId.size() <= 128)) &&
        (!('chauffeurId' in data) || (data.chauffeurId is string && data.chauffeurId.size() <= 128));
    }

    function isValidProforma(data) {
      return data.amount is number && data.amount >= 0 &&
        (!('number' in data) || (data.number is string && data.number.size() <= 50)) &&
        (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('route' in data) || (data.route is string && data.route.size() <= 200)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidFacture(data) {
      return data.amount is number && data.amount >= 0 &&
        (!('number' in data) || (data.number is string && data.number.size() <= 50)) &&
        (!('client' in data) || (data.client is string && data.client.size() <= 150)) &&
        (!('proforma' in data) || (data.proforma is string && data.proforma.size() <= 50)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidUtilisateur(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('telephone' in data) || (data.telephone is string && data.telephone.size() <= 50)) &&
        (!('statutCompte' in data) || (data.statutCompte in ["actif", "inactif", "Actif", "Inactif"])) &&
        (!('statutClient' in data) || (data.statutClient in ["prospect", "client", "Prospect", "Client"])) &&
        (!('role' in data) || (data.role is string && (
          data.role.lower() in [
            "admin", "direction", "comptabilite", 
            "secretaire", "operations", "chauffeur", 
            "client", "lecture_seule"
          ]
        ))) &&
        (!('roles' in data) || (data.roles is list && data.roles.size() > 0 && data.roles.size() <= 10 &&
          data.roles.hasOnly([
            "admin", "direction", "comptabilite", 
            "secretaire", "operations", "chauffeur", 
            "client", "lecture_seule"
          ])
        ));
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 500;
    }

    function isValidSetting(data) {
      return data.company is string && data.company.size() > 0 && data.company.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250));
    }

    // -------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------

    // 1. Clients
    match /clients/{clientId} {
      allow get: if canReadOperations() || 
        (isClient() && (clientId == request.auth.uid || isClientDoc(existing())));
      allow list: if canReadOperations() || 
        (isClient() && isClientDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(clientId) && isValidClient(incoming());
      allow delete: if isAdmin() && isValidId(clientId);
    }

    // 2. Élèves
    match /eleves/{eleveId} {
      allow get, list: if canReadOperations() || 
        (isClient() && isClientDoc(existing())) || 
        (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(eleveId) && isValidEleve(incoming());
      allow delete: if isAdmin() && isValidId(eleveId);
    }

    // 3. Abonnements
    match /abonnements/{abonnementId} {
      allow get, list: if canReadOperations() || 
        (isClient() && isClientDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(abonnementId) && isValidAbonnement(incoming());
      allow delete: if isAdmin() && isValidId(abonnementId);
    }

    // 4. Chauffeurs (/chauffeurs and alias /drivers)
    match /chauffeurs/{chauffeurId} {
      allow get: if canReadOperations() || 
        (isChauffeur() && (chauffeurId == request.auth.uid || isChauffeurDoc(existing())));
      allow list: if canReadOperations() || 
        (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(chauffeurId) && isValidChauffeur(incoming());
      allow delete: if isAdmin() && isValidId(chauffeurId);
    }
    match /drivers/{driverId} {
      allow get: if canReadOperations() || (isChauffeur() && (driverId == request.auth.uid || isChauffeurDoc(existing())));
      allow list: if canReadOperations() || (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(driverId);
      allow delete: if isAdmin() && isValidId(driverId);
    }

    // 5. Véhicules (/vehicules and alias /vehicles)
    match /vehicules/{vehiculeId} {
      allow get, list: if canReadOperations() || 
        (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(vehiculeId) && isValidVehicule(incoming());
      allow delete: if isAdmin() && isValidId(vehiculeId);
    }
    match /vehicles/{vehicleId} {
      allow get, list: if canReadOperations() || (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(vehicleId);
      allow delete: if isAdmin() && isValidId(vehicleId);
    }

    // 6. Plannings (/plannings and alias /planning)
    match /plannings/{planningId} {
      allow get, list: if canReadOperations() || 
        (isChauffeur() && isChauffeurDoc(existing()));
      allow create: if canManageOperations() && isValidId(planningId) && isValidPlanning(incoming());
      allow update: if isValidId(planningId) && isValidPlanning(incoming()) && (
        canManageOperations() || (
          isChauffeur() &&
          isChauffeurDoc(existing()) &&
          (!('chauffeurId' in incoming()) || incoming().chauffeurId == existing().chauffeurId) &&
          (!('driverId' in incoming()) || incoming().driverId == existing().driverId) &&
          (!('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('client' in incoming()) || incoming().client == existing().client) &&
          (!('driver' in incoming()) || incoming().driver == existing().driver) &&
          (!('vehicle' in incoming()) || incoming().vehicle == existing().vehicle) &&
          (!('amount' in incoming()) || incoming().amount == existing().amount) &&
          (!('price' in incoming()) || incoming().price == existing().price) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
        )
      );
      allow delete: if isAdmin() && isValidId(planningId);
    }
    match /planning/{planningId} {
      allow get, list: if canReadOperations() || (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(planningId);
      allow delete: if isAdmin() && isValidId(planningId);
    }

    // 7. Paiements (/paiements and alias /payments)
    match /paiements/{paiementId} {
      allow get, list: if canReadFinances() || 
        (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(paiementId) && isValidPaiement(incoming());
      allow delete: if isAdmin() && isValidId(paiementId);
    }
    match /payments/{paymentId} {
      allow get, list: if canReadFinances() || (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(paymentId);
      allow delete: if isAdmin() && isValidId(paymentId);
    }

    // 8. Réservations (/reservations and alias /bookings)
    match /reservations/{reservationId} {
      allow get, list: if canReadOperations() || 
        (isClient() && isClientDoc(existing())) ||
        (isChauffeur() && isChauffeurDoc(existing()));
      allow create: if isValidId(reservationId) && isValidReservation(incoming()) && (
        canManageOperations() || (
          isClient() &&
          (
            (('clientId' in incoming()) && incoming().clientId == request.auth.uid) ||
            (('uid' in incoming()) && incoming().uid == request.auth.uid) ||
            (('email' in incoming()) && incoming().email == request.auth.token.email)
          )
        )
      );
      allow update: if canManageOperations() && isValidId(reservationId) && isValidReservation(incoming());
      allow delete: if isAdmin() && isValidId(reservationId);
    }
    match /bookings/{bookingId} {
      allow get, list: if canReadOperations() || (isClient() && isClientDoc(existing())) || (isChauffeur() && isChauffeurDoc(existing()));
      allow create, update: if canManageOperations() && isValidId(bookingId);
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // 9. Finances & Dépenses (/finances and alias /expenses)
    match /finances/{financeId} {
      allow get, list: if canReadGlobalFinances();
      allow create, update: if canManageFinances() && isValidId(financeId) && isValidFinance(incoming());
      allow delete: if isAdmin() && isValidId(financeId);
    }
    match /expenses/{expenseId} {
      allow get, list: if canReadGlobalFinances();
      allow create, update: if canManageFinances() && isValidId(expenseId);
      allow delete: if isAdmin() && isValidId(expenseId);
    }

    // 10. Proformas (/proformas and alias /quotes)
    match /proformas/{proformaId} {
      allow get, list: if canReadFinances() || 
        (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(proformaId) && isValidProforma(incoming());
      allow delete: if isAdmin() && isValidId(proformaId);
    }
    match /quotes/{quoteId} {
      allow get, list: if canReadFinances() || (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(quoteId);
      allow delete: if isAdmin() && isValidId(quoteId);
    }

    // 11. Factures (/factures and alias /invoices)
    match /factures/{factureId} {
      allow get, list: if canReadFinances() || 
        (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(factureId) && isValidFacture(incoming());
      allow delete: if isAdmin() && isValidId(factureId);
    }
    match /invoices/{invoiceId} {
      allow get, list: if canReadFinances() || (isClient() && isClientDoc(existing()));
      allow create, update: if canManageFinances() && isValidId(invoiceId);
      allow delete: if isAdmin() && isValidId(invoiceId);
    }

    // 12. Utilisateurs & Rôles
    match /utilisateurs/{utilisateurId} {
      // ADMIN, SECRETAIRE or signed-in users can list users; individual lookup allowed by valid ID
      allow list: if isAdmin() || isSecretaire() || isSignedIn();
      allow get: if isValidId(utilisateurId);

      // Initial self-registration (MUST be role 'lecture_seule' or 'client', statutCompte 'actif', statutClient 'prospect' or 'client', unless super admin)
      // Or creation by ADMIN (any role) or SECRETAIRE (strictly non-admin roles)
      allow create: if isValidId(utilisateurId) && isValidUtilisateur(incoming()) && (
        isAdmin() || (
          isSecretaire() &&
          utilisateurId != request.auth.uid &&
          !isTargetSuperAdminEmail(incoming().email) &&
          (!('roles' in incoming()) || (
            !("admin" in incoming().roles) &&
            incoming().roles.hasOnly(["direction", "comptabilite", "secretaire", "operations", "chauffeur", "client", "lecture_seule"])
          )) &&
          (!('role' in incoming()) || incoming().role.lower() != "admin")
        ) || (
          isSignedIn() && request.auth.uid == utilisateurId &&
          (
            (isSuperAdminEmail() && (
              (!('roles' in incoming()) || incoming().roles == ["admin"]) &&
              (!('role' in incoming()) || incoming().role.lower() == "admin")
            )) ||
            (!isSuperAdminEmail() && (
              (!('roles' in incoming()) || incoming().roles == ["lecture_seule"] || incoming().roles == ["client"]) &&
              (!('role' in incoming()) || incoming().role.lower() in ["lecture_seule", "client"]) &&
              (!('statutClient' in incoming()) || incoming().statutClient in ["prospect", "Prospect", "client", "Client"])
            ))
          ) &&
          (!('status' in incoming()) || incoming().status in ["actif", "Actif"]) &&
          (!('statutCompte' in incoming()) || incoming().statutCompte in ["actif", "Actif"]) &&
          (!('permissions' in incoming()) || incoming().permissions == {})
        ) || (
          // Super admin document sync
          isTargetSuperAdminEmail(incoming().email) &&
          (!('status' in incoming()) || incoming().status in ["actif", "Actif"]) &&
          (!('statutCompte' in incoming()) || incoming().statutCompte in ["actif", "Actif"])
        ) || (
          // Public web registration for new clients and prospects (no administrative privileges)
          (!('roles' in incoming()) || incoming().roles == ["lecture_seule"] || incoming().roles == ["client"]) &&
          (!('role' in incoming()) || incoming().role.lower() in ["lecture_seule", "client"]) &&
          (!('statutClient' in incoming()) || incoming().statutClient in ["prospect", "Prospect", "client", "Client"]) &&
          (!('status' in incoming()) || incoming().status in ["actif", "Actif"]) &&
          (!('statutCompte' in incoming()) || incoming().statutCompte in ["actif", "Actif"]) &&
          (!('permissions' in incoming()) || incoming().permissions == {})
        )
      );

      // Updates:
      // 1. ADMIN can update users, but cannot strip admin from super admin email
      // 2. SECRETAIRE can assign/remove allowed roles for other users, but can never assign ADMIN nor touch existing Admins
      // 3. User can update personal fields; or upgrade from lecture_seule to client upon confirmed reservation
      //    User CAN NEVER self-assign admin, direction, comptabilite, secretaire, operations, or chauffeur.
      allow update: if isValidId(utilisateurId) && isValidUtilisateur(incoming()) && (
        (
          isAdmin() &&
          !(isTargetSuperAdminEmail(existing().email) && ('roles' in incoming()) && !("admin" in incoming().roles))
        ) ||
        (
          isSecretaire() &&
          utilisateurId != request.auth.uid &&
          !isTargetSuperAdminEmail(existing().email) &&
          !(("admin" in getUserRolesFor(existing())) || (('role' in existing()) && existing().role.lower() == "admin")) &&
          (!('roles' in incoming()) || (
            !("admin" in incoming().roles) &&
            incoming().roles.hasOnly(["direction", "comptabilite", "secretaire", "operations", "chauffeur", "client", "lecture_seule"])
          )) &&
          (!('role' in incoming()) || incoming().role.lower() != "admin") &&
          (!('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('email' in incoming()) || incoming().email == existing().email) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
          (!('createdBy' in incoming()) || incoming().createdBy == existing().createdBy)
        ) ||
        (
          isSignedIn() && request.auth.uid == utilisateurId &&
          (!('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
          (!('createdBy' in incoming()) || incoming().createdBy == existing().createdBy) &&
          // Cannot modify status or statutCompte
          (!('status' in incoming()) || incoming().status == existing().status) &&
          (!('statutCompte' in incoming()) || incoming().statutCompte == existing().statutCompte) &&
          // Cannot self-assign any administrative/staff roles
          (!('roles' in incoming()) || !incoming().roles.hasAny(["admin", "direction", "comptabilite", "secretaire", "operations", "chauffeur"])) &&
          (!('role' in incoming()) || !(["admin", "direction", "comptabilite", "secretaire", "operations", "chauffeur"].hasAny([incoming().role.lower()]))) &&
          // Either updating personal contact info or promoting to client status
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nom', 'prenom', 'username', 'aliases', 'phone', 'telephone', 'photoURL', 'avatar', 'passwordHash', 'notes', 'updatedAt', 'updatedBy', 'lastLoginAt']) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['statutClient', 'roles', 'role', 'name', 'nom', 'prenom', 'username', 'aliases', 'phone', 'telephone', 'photoURL', 'avatar', 'passwordHash', 'updatedAt', 'updatedBy']) &&
              incoming().statutClient in ['client', 'Client'] &&
              incoming().roles.hasOnly(['client', 'lecture_seule'])
            )
          )
        ) ||
        (
          // Super admin email profile update
          (isTargetSuperAdminEmail(existing().email) || isTargetSuperAdminEmail(incoming().email)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nom', 'prenom', 'username', 'aliases', 'phone', 'telephone', 'photoURL', 'avatar', 'passwordHash', 'notes', 'status', 'statutCompte', 'statutClient', 'roles', 'role', 'updatedAt', 'updatedBy', 'lastLoginAt'])
        ) ||
        (
          // Profile updates for web users without administrative role escalation
          (!('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
          (!('roles' in incoming()) || !incoming().roles.hasAny(["admin", "direction", "comptabilite", "secretaire", "operations", "chauffeur"])) &&
          (!('role' in incoming()) || !(["admin", "direction", "comptabilite", "secretaire", "operations", "chauffeur"].hasAny([incoming().role.lower()]))) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nom', 'prenom', 'username', 'aliases', 'phone', 'telephone', 'photoURL', 'avatar', 'passwordHash', 'notes', 'updatedAt', 'updatedBy', 'lastLoginAt'])
        )
      );

      // Only Admin can delete a user, and Super Admin cannot be deleted
      allow delete: if isAdmin() && isValidId(utilisateurId) && 
        !(isTargetSuperAdminEmail(existing().email) || utilisateurId == request.auth.uid);
    }

    // 13. Notifications
    match /notifications/{notificationId} {
      allow get, list: if isVerified() && isUserActive() && (
        canManageNotifications() || (
          (isClient() || isChauffeur()) && isNotificationTarget(existing())
        )
      );
      allow create: if isVerified() && isUserActive() && isValidId(notificationId) && isValidNotification(incoming()) && canManageNotifications();
      allow update: if isVerified() && isUserActive() && isValidId(notificationId) && (
        canManageNotifications() || (
          (isClient() || isChauffeur()) && isNotificationTarget(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt', 'updatedBy'])
        )
      );
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // 14. Settings
    match /settings/{settingId} {
      allow get, list: if isVerified() && isUserActive() && (isAdmin() || isDirection());
      allow create, update: if isAdmin() && isValidId(settingId) && isValidSetting(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // 15. Admins
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }

    // 16. Prospects
    match /prospects/{prospectId} {
      allow get, list: if canReadOperations();
      allow create, update: if canManageOperations() && isValidId(prospectId);
      allow delete: if isAdmin() && isValidId(prospectId);
    }

    // 17. Healthcheck test collection
    match /test/{testId} {
      allow get: if testId == 'connection';
      allow write: if isAdmin();
    }
  }
}
